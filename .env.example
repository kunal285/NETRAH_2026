# ===============================================================
# PRAHARI V3 — GLOBAL ENVIRONMENT CONFIGURATION
# ===============================================================

# ---------------------------------------------------------------
# Google Gemini LLM API (Server-side ONLY — Never expose in frontend!)
# ---------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EVENT_COOLDOWN_SECONDS=5

# ---------------------------------------------------------------
# Service Network URLs
# ---------------------------------------------------------------
BACKEND_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000
ROBOT_API_URL=http://192.168.4.1:5000
ROBOT_CAMERA_STREAM_URL=http://192.168.4.1:8080/video
ROBOT_ID=PRAHARI-01

# ---------------------------------------------------------------
# Ports
# ---------------------------------------------------------------
PORT=4000
BACKEND_PORT=4000
AI_SERVICE_PORT=8000

# ---------------------------------------------------------------
# Database Configuration (MongoDB)
# ---------------------------------------------------------------
DATABASE_URL=mongodb://localhost:27017/prahari
MONGODB_URI=mongodb://localhost:27017/prahari

# ---------------------------------------------------------------
# AWS S3 Storage (Optional for Snapshot persistence)
# ---------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=prahari-image-storage-2026

# ---------------------------------------------------------------
# AI Perception & Inference Rate
# ---------------------------------------------------------------
AI_PROCESS_FPS=10.0
VEHICLE_CONFIDENCE=0.40
PLATE_CONFIDENCE=0.40
AMBULANCE_CONFIDENCE=0.50
FACE_CONFIDENCE=0.50
OCR_CONFIDENCE=0.70

# ---------------------------------------------------------------
# Frontend Public Environment Variables
# ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_ROBOT_CAMERA_STREAM_URL=http://192.168.4.1:8080/video
NEXT_PUBLIC_DEMO_MODE=false
