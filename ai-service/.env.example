# ===============================================================
# PRAHARI V3 — AI PERCEPTION SERVICE CONFIGURATION TEMPLATE
# ===============================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Backend Communication
BACKEND_URL=http://localhost:4000
ROBOT_ID=PRAHARI-01

# Camera Video Stream Source (Raspberry Pi Camera MJPEG or ESP32-CAM)
ROBOT_CAMERA_STREAM_URL=http://192.168.4.1:8080/video

# AI Perception & Inference Rate
AI_PROCESS_FPS=10.0
MODEL_NAME=YOLOv8-TrafficNet-PRAHARI-MK3

# Multi-Class Detection Thresholds (0.0 to 1.0)
VEHICLE_CONFIDENCE=0.40
PLATE_CONFIDENCE=0.40
AMBULANCE_CONFIDENCE=0.50
FACE_CONFIDENCE=0.50
OCR_CONFIDENCE=0.70

# Event Cooldowns (in milliseconds to prevent event floods)
VEHICLE_EVENT_COOLDOWN_MS=2000
ANPR_EVENT_COOLDOWN_MS=5000
FACE_EVENT_COOLDOWN_MS=5000
AMBULANCE_EVENT_COOLDOWN_MS=5000

# Virtual Traffic Counting Line Configuration
COUNTING_LINE_ENABLED=true
COUNTING_LINE_Y_RATIO=0.65
