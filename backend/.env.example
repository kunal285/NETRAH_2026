# ===============================================================
# PRAHARI V3 ENVIRONMENT CONFIGURATION (BACKEND)
# ===============================================================

# Server Ports & URLs
PORT=4000
BACKEND_PORT=4000
BACKEND_URL=http://localhost:4000

# Database Connection (MongoDB)
DATABASE_URL=mongodb://localhost:27017/prahari
MONGODB_URI=mongodb://localhost:27017/prahari

# External Service Endpoints
ROBOT_ID=PRAHARI-01
DEFAULT_ROBOT_ID=PRAHARI-01
ROBOT_API_URL=http://192.168.4.1:5000
ROBOT_CAMERA_STREAM_URL=http://192.168.4.1:8080/video
AI_SERVICE_URL=http://localhost:8000
PRAHARI_DEVICE_SECRET=PRAHARI_DEVICE_SECRET_KEY_2026

# Google Gemini LLM Service Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EVENT_COOLDOWN_SECONDS=5
GEMINI_TIMEOUT_MS=12000

# AWS S3 Storage Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=prahari-image-storage-2026
# Optional (e.g. for MinIO / LocalStack):
AWS_ENDPOINT_URL=

# AI Perception Thresholds
AI_PROCESS_FPS=10
VEHICLE_CONFIDENCE=0.40
PLATE_CONFIDENCE=0.40
AMBULANCE_CONFIDENCE=0.50
FACE_CONFIDENCE=0.50
OCR_CONFIDENCE=0.70

# Event Cooldown Periods (in milliseconds)
VEHICLE_EVENT_COOLDOWN_MS=2000
ANPR_EVENT_COOLDOWN_MS=5000
FACE_EVENT_COOLDOWN_MS=5000
AMBULANCE_EVENT_COOLDOWN_MS=5000

# Counting Configuration
COUNTING_LINE_ENABLED=true
COUNTING_LINE_Y_RATIO=0.65

# Security
JWT_SECRET=prahari-v3-secret-key-2026
