# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# MongoDB Database Connection String
MONGODB_URI=

# JWT Secret for User/Operator Authentication
JWT_SECRET=

# Image Storage Configuration (S3 / MinIO / Local Object Store)
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_ACCESS_KEY=
IMAGE_STORAGE_SECRET_KEY=

# External Services
ROBOT_API_URL=
ROBOT_CAMERA_STREAM_URL=

# Raspberry Pi 5 Subsystem Integration
ROBOT_ID=PRAHARI-01
PRAHARI_DEVICE_SECRET=PRAHARI_DEVICE_SECRET_KEY_2026

# Client URLs (optional overrides)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
TELEMETRY_SAMPLE_INTERVAL_MS=1000
DEFAULT_ROBOT_ID=PRAHARI-MK1
BACKEND_PORT=4000
